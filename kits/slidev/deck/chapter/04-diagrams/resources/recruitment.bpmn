<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_recruitment" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="recruitment" isExecutable="false">
    <bpmn:startEvent id="startEvent_applicationReceived" name="Application&#10;received">
      <bpmn:outgoing>flow_applicationReceivedToScreenApplication</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_App" />
    </bpmn:startEvent>
    <bpmn:userTask id="userTask_screenApplication" name="Screen application">
      <bpmn:incoming>flow_applicationReceivedToScreenApplication</bpmn:incoming>
      <bpmn:outgoing>flow_screenApplicationToQualifies</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gateway_qualifies" name="Qualifies?">
      <bpmn:incoming>flow_screenApplicationToQualifies</bpmn:incoming>
      <bpmn:outgoing>flow_qualifiesToScheduleInterview</bpmn:outgoing>
      <bpmn:outgoing>flow_qualifiesToRejectedBeforeInterview</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="userTask_scheduleInterview" name="Schedule interview">
      <bpmn:incoming>flow_qualifiesToScheduleInterview</bpmn:incoming>
      <bpmn:outgoing>flow_scheduleInterviewToConductInterview</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="userTask_conductInterview" name="Conduct interview">
      <bpmn:incoming>flow_scheduleInterviewToConductInterview</bpmn:incoming>
      <bpmn:outgoing>flow_conductInterviewToHire</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gateway_hire" name="Hire?">
      <bpmn:incoming>flow_conductInterviewToHire</bpmn:incoming>
      <bpmn:outgoing>flow_hireToSendOffer</bpmn:outgoing>
      <bpmn:outgoing>flow_hireToRejectedAfterInterview</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="task_sendOffer" name="Send offer">
      <bpmn:incoming>flow_hireToSendOffer</bpmn:incoming>
      <bpmn:outgoing>flow_sendOfferToOfferSent</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="endEvent_offerSent" name="Offer sent">
      <bpmn:incoming>flow_sendOfferToOfferSent</bpmn:incoming>
      <bpmn:messageEventDefinition id="MED_Offer" />
    </bpmn:endEvent>
    <bpmn:endEvent id="endEvent_rejectedBeforeInterview" name="Rejected&#10;before interview">
      <bpmn:incoming>flow_qualifiesToRejectedBeforeInterview</bpmn:incoming>
      <bpmn:messageEventDefinition id="MED_RejectEarly" />
    </bpmn:endEvent>
    <bpmn:endEvent id="endEvent_rejectedAfterInterview" name="Rejected&#10;after interview">
      <bpmn:incoming>flow_hireToRejectedAfterInterview</bpmn:incoming>
      <bpmn:messageEventDefinition id="MED_RejectLate" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_applicationReceivedToScreenApplication" sourceRef="startEvent_applicationReceived" targetRef="userTask_screenApplication" />
    <bpmn:sequenceFlow id="flow_screenApplicationToQualifies" sourceRef="userTask_screenApplication" targetRef="gateway_qualifies" />
    <bpmn:sequenceFlow id="flow_qualifiesToScheduleInterview" name="yes" sourceRef="gateway_qualifies" targetRef="userTask_scheduleInterview" />
    <bpmn:sequenceFlow id="flow_scheduleInterviewToConductInterview" sourceRef="userTask_scheduleInterview" targetRef="userTask_conductInterview" />
    <bpmn:sequenceFlow id="flow_conductInterviewToHire" sourceRef="userTask_conductInterview" targetRef="gateway_hire" />
    <bpmn:sequenceFlow id="flow_hireToSendOffer" name="yes" sourceRef="gateway_hire" targetRef="task_sendOffer" />
    <bpmn:sequenceFlow id="flow_sendOfferToOfferSent" sourceRef="task_sendOffer" targetRef="endEvent_offerSent" />
    <bpmn:sequenceFlow id="flow_qualifiesToRejectedBeforeInterview" name="no" sourceRef="gateway_qualifies" targetRef="endEvent_rejectedBeforeInterview" />
    <bpmn:sequenceFlow id="flow_hireToRejectedAfterInterview" name="no" sourceRef="gateway_hire" targetRef="endEvent_rejectedAfterInterview" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="recruitment">
      <bpmndi:BPMNShape id="startEvent_applicationReceived_di" bpmnElement="startEvent_applicationReceived">
        <dc:Bounds x="50" y="82" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="36" y="125" width="64" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="userTask_screenApplication_di" bpmnElement="userTask_screenApplication">
        <dc:Bounds x="140" y="60" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_qualifies_di" bpmnElement="gateway_qualifies" isMarkerVisible="true">
        <dc:Bounds x="300" y="75" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="294" y="48" width="62" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="userTask_scheduleInterview_di" bpmnElement="userTask_scheduleInterview">
        <dc:Bounds x="400" y="60" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="userTask_conductInterview_di" bpmnElement="userTask_conductInterview">
        <dc:Bounds x="570" y="60" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_hire_di" bpmnElement="gateway_hire" isMarkerVisible="true">
        <dc:Bounds x="740" y="75" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="745" y="48" width="40" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_sendOffer_di" bpmnElement="task_sendOffer">
        <dc:Bounds x="840" y="60" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endEvent_offerSent_di" bpmnElement="endEvent_offerSent">
        <dc:Bounds x="1000" y="82" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="992" y="125" width="52" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endEvent_rejectedBeforeInterview_di" bpmnElement="endEvent_rejectedBeforeInterview">
        <dc:Bounds x="390" y="220" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="353" y="263" width="110" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endEvent_rejectedAfterInterview_di" bpmnElement="endEvent_rejectedAfterInterview">
        <dc:Bounds x="830" y="220" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="791" y="263" width="114" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_applicationReceivedToScreenApplication_di" bpmnElement="flow_applicationReceivedToScreenApplication">
        <di:waypoint x="86" y="100" />
        <di:waypoint x="140" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_screenApplicationToQualifies_di" bpmnElement="flow_screenApplicationToQualifies">
        <di:waypoint x="260" y="100" />
        <di:waypoint x="300" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_qualifiesToScheduleInterview_di" bpmnElement="flow_qualifiesToScheduleInterview">
        <di:waypoint x="350" y="100" />
        <di:waypoint x="400" y="100" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="365" y="82" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_scheduleInterviewToConductInterview_di" bpmnElement="flow_scheduleInterviewToConductInterview">
        <di:waypoint x="530" y="100" />
        <di:waypoint x="570" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_conductInterviewToHire_di" bpmnElement="flow_conductInterviewToHire">
        <di:waypoint x="700" y="100" />
        <di:waypoint x="740" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_hireToSendOffer_di" bpmnElement="flow_hireToSendOffer">
        <di:waypoint x="790" y="100" />
        <di:waypoint x="840" y="100" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="805" y="82" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_sendOfferToOfferSent_di" bpmnElement="flow_sendOfferToOfferSent">
        <di:waypoint x="960" y="100" />
        <di:waypoint x="1000" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_qualifiesToRejectedBeforeInterview_di" bpmnElement="flow_qualifiesToRejectedBeforeInterview">
        <di:waypoint x="325" y="125" />
        <di:waypoint x="325" y="238" />
        <di:waypoint x="390" y="238" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="333" y="220" width="26" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_hireToRejectedAfterInterview_di" bpmnElement="flow_hireToRejectedAfterInterview">
        <di:waypoint x="765" y="125" />
        <di:waypoint x="765" y="238" />
        <di:waypoint x="830" y="238" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="773" y="220" width="26" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
